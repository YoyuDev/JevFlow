# ---------------------------------------------------------------------------
# JevFlow environment
# Copy to `.env` and fill in what you need.
# Everything works with EMPTY values — the Mock runtime takes over.
# ---------------------------------------------------------------------------

# --- server -----------------------------------------------------------------
PORT=3000
HOST=127.0.0.1

# SQLite file (relative paths are resolved from the repo root)
DATABASE_FILE=data/jevflow.db

# --- Jev (decision engine) --------------------------------------------------
# Leave JEV_API_KEY empty to use MockJevClient (deterministic, offline).
# A real Jev must expose:  POST {JEV_BASE_URL}/decide
#   body     { question, choices, context, model? }
#   response anything normalizeDecision() understands — e.g.
#            { "choice": "search", "confidence": 0.91, "reason": "..." }
JEV_BASE_URL=
JEV_API_KEY=
JEV_MODEL=

# --- LLM --------------------------------------------------------------------
# Leave LLM_API_KEY empty to use MockLLMClient (deterministic, offline).
# Any OpenAI-compatible endpoint works: OpenAI, DeepSeek, SiliconFlow, Ollama...
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- runtime ----------------------------------------------------------------
# Set to `true` to ignore every credential above and stay fully offline.
# Useful for demos, CI and tests.
JEVFLOW_FORCE_MOCK=

# --- logging ----------------------------------------------------------------
LOG_LEVEL=info
